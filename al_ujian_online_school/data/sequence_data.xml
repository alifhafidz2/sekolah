<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_bank_soal" model="ir.sequence">
            <field name="name">Bank Soal Sequence</field>
            <field name="code">ujian.bank_soal</field>
            <field name="prefix">SOAL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_paket_ujian" model="ir.sequence">
            <field name="name">Paket Ujian Sequence</field>
            <field name="code">ujian.paket</field>
            <field name="prefix">UJN/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
