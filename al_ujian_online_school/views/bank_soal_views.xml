<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_soal_list" model="ir.ui.view">
        <field name="name">ujian.bank_soal.list</field>
        <field name="model">ujian.bank_soal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="kategori_id"/>
                <field name="mata_pelajaran_id"/>
                <field name="tipe_soal"/>
                <field name="tingkat_kesulitan"/>
                <field name="bobot"/>
                <field name="used_count"/>
                <field name="correct_rate" widget="progressbar"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_bank_soal_form" model="ir.ui.view">
        <field name="name">ujian.bank_soal.form</field>
        <field name="model">ujian.bank_soal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_view_statistics" type="object" string="Lihat Statistik" class="oe_highlight" icon="fa-bar-chart"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_statistics" type="object" class="oe_stat_button" icon="fa-bar-chart">
                            <field name="correct_rate" widget="statinfo" string="% Benar"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-file-text-o" disabled="1">
                            <field name="used_count" widget="statinfo" string="Digunakan"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Tidak Aktif" bg_color="text-bg-danger" invisible="is_active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="kategori_id"/>
                            <field name="mata_pelajaran_id"/>
                            <field name="tipe_soal"/>
                        </group>
                        <group>
                            <field name="tingkat_kesulitan"/>
                            <field name="bobot"/>
                            <field name="guru_id"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Soal">
                            <group>
                                <field name="pertanyaan" colspan="2" nolabel="1" placeholder="Tulis pertanyaan di sini..."/>
                            </group>
                            <group>
                                <field name="gambar" widget="image" class="oe_avatar"/>
                                <field name="gambar_filename" invisible="1"/>
                            </group>
                            <group invisible="tipe_soal in ['isian', 'essay']">
                                <field name="pilihan_ids" nolabel="1" colspan="2">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="label"/>
                                        <field name="teks"/>
                                        <field name="is_correct"/>
                                        <field name="gambar" widget="image" options="{'size': [50, 50]}"/>
                                    </list>
                                </field>
                            </group>
                            <group invisible="tipe_soal not in ['isian', 'essay']">
                                <field name="jawaban_benar" required="tipe_soal == 'isian'"/>
                                <field name="jawaban_benar_alt" invisible="tipe_soal != 'isian'"/>
                            </group>
                        </page>
                        <page string="Pembahasan">
                            <field name="pembahasan" placeholder="Tulis pembahasan jawaban di sini..."/>
                        </page>
                        <page string="Pengaturan">
                            <group>
                                <field name="kelas_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Statistik">
                            <group>
                                <group>
                                    <field name="correct_rate"/>
                                    <field name="discrimination_index"/>
                                </group>
                                <group>
                                    <field name="used_count"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bank_soal_kanban" model="ir.ui.view">
        <field name="name">ujian.bank_soal.kanban</field>
        <field name="model">ujian.bank_soal</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="tipe_soal"/>
                <field name="tingkat_kesulitan"/>
                <field name="kategori_id"/>
                <field name="correct_rate"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="kategori_id"/>
                            </div>
                            <div class="mt-2">
                                <span class="badge bg-primary me-1"><field name="tipe_soal"/></span>
                                <span t-attf-class="badge #{record.tingkat_kesulitan.raw_value == 'mudah' ? 'bg-success' : record.tingkat_kesulitan.raw_value == 'sedang' ? 'bg-warning' : 'bg-danger'}">
                                    <field name="tingkat_kesulitan"/>
                                </span>
                            </div>
                            <div class="mt-2">
                                <field name="correct_rate" widget="progressbar"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_bank_soal_search" model="ir.ui.view">
        <field name="name">ujian.bank_soal.search</field>
        <field name="model">ujian.bank_soal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pertanyaan"/>
                <field name="kategori_id"/>
                <field name="mata_pelajaran_id"/>
                <field name="guru_id"/>
                <separator/>
                <filter name="pg" string="Pilihan Ganda" domain="[('tipe_soal', '=', 'pg')]"/>
                <filter name="essay" string="Essay" domain="[('tipe_soal', '=', 'essay')]"/>
                <filter name="isian" string="Isian" domain="[('tipe_soal', '=', 'isian')]"/>
                <separator/>
                <filter name="mudah" string="Mudah" domain="[('tingkat_kesulitan', '=', 'mudah')]"/>
                <filter name="sedang" string="Sedang" domain="[('tingkat_kesulitan', '=', 'sedang')]"/>
                <filter name="sulit" string="Sulit" domain="[('tingkat_kesulitan', '=', 'sulit')]"/>
                <separator/>
                <filter name="active" string="Aktif" domain="[('is_active', '=', True)]"/>
                <filter name="inactive" string="Tidak Aktif" domain="[('is_active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_kategori" string="Kategori" context="{'group_by': 'kategori_id'}"/>
                    <filter name="group_mapel" string="Mata Pelajaran" context="{'group_by': 'mata_pelajaran_id'}"/>
                    <filter name="group_tipe" string="Tipe Soal" context="{'group_by': 'tipe_soal'}"/>
                    <filter name="group_kesulitan" string="Tingkat Kesulitan" context="{'group_by': 'tingkat_kesulitan'}"/>
                    <filter name="group_guru" string="Guru" context="{'group_by': 'guru_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bank_soal" model="ir.actions.act_window">
        <field name="name">Bank Soal</field>
        <field name="res_model">ujian.bank_soal</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat soal pertama
            </p>
            <p>
                Buat berbagai jenis soal: Pilihan Ganda, Essay, Isian Singkat, dan lainnya.
            </p>
        </field>
    </record>
</odoo>
