<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kategori_soal_list" model="ir.ui.view">
        <field name="name">ujian.kategori_soal.list</field>
        <field name="model">ujian.kategori_soal</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="mata_pelajaran_id"/>
                <field name="parent_id"/>
                <field name="soal_count"/>
            </list>
        </field>
    </record>

    <record id="view_kategori_soal_form" model="ir.ui.view">
        <field name="name">ujian.kategori_soal.form</field>
        <field name="model">ujian.kategori_soal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nama Kategori"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="mata_pelajaran_id"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="soal_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Deskripsi kategori..."/>
                    </group>
                    <notebook>
                        <page string="Sub Kategori" invisible="not child_ids">
                            <field name="child_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="soal_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kategori_soal_search" model="ir.ui.view">
        <field name="name">ujian.kategori_soal.search</field>
        <field name="model">ujian.kategori_soal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="mata_pelajaran_id"/>
                <filter name="active" string="Aktif" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Tidak Aktif" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_mapel" string="Mata Pelajaran" context="{'group_by': 'mata_pelajaran_id'}"/>
                    <filter name="group_parent" string="Kategori Induk" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kategori_soal" model="ir.actions.act_window">
        <field name="name">Kategori Soal</field>
        <field name="res_model">ujian.kategori_soal</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat kategori soal pertama
            </p>
            <p>
                Kategori digunakan untuk mengelompokkan soal berdasarkan topik atau materi.
            </p>
        </field>
    </record>
</odoo>
