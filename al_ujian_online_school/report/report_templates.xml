                                    </td>
                                    <td class="info-right">
                                        <div class="info-title">Pengaturan Ujian</div>
                                        <div class="info-detail"><span>Guru Pengampu</span>: <span t-field="doc.guru_id.name"/></div>
                                        <div class="info-detail"><span>Periode</span>: <span t-field="doc.tanggal_mulai" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/> - <span t-field="doc.tanggal_selesai" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></div>
                                        <div class="info-detail"><span>KKM</span>: <strong><span t-field="doc.passing_grade"/></strong></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="stats-section">
                            <table class="stats-table">
                                <tr>
                                    <td width="25%"><div class="stat-box blue"><div class="stat-label">Total Peserta</div><div class="stat-value blue"><t t-esc="doc.peserta_count"/></div></div></td>
                                    <td width="25%"><div class="stat-box cyan"><div class="stat-label">Rata-rata</div><div class="stat-value cyan"><t t-esc="'%.1f' % doc.rata_rata"/></div></div></td>
                                    <td width="25%"><div class="stat-box green"><div class="stat-label">Lulus</div><div class="stat-value green"><t t-esc="doc.lulus_count"/></div></div></td>
                                    <td width="25%"><div class="stat-box red"><div class="stat-label">Tidak Lulus</div><div class="stat-value red"><t t-esc="doc.peserta_selesai - doc.lulus_count"/></div></div></td>
                                </tr>
                            </table>
                        </div>

                        <div class="detail-section">
                            <div class="section-title">Daftar Nilai Peserta</div>
                            <table class="detail-table">
                                <thead>
                                    <tr>
                                        <th class="center" style="width: 5%;">No</th>
                                        <th class="center" style="width: 12%;">NIS</th>
                                        <th style="width: 30%;">Nama Siswa</th>
                                        <th class="center" style="width: 13%;">Kelas</th>
                                        <th class="center" style="width: 10%;">Benar</th>
                                        <th class="center" style="width: 10%;">Salah</th>
                                        <th class="center" style="width: 10%;">Nilai</th>
                                        <th class="center" style="width: 10%;">Ket</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.peserta_ids.filtered(lambda p: p.state == 'selesai').sorted(lambda p: (-p.nilai, p.siswa_id.name))" t-as="p">
                                        <tr>
                                            <td class="center" t-esc="p_index + 1"/>
                                            <td class="center"><t t-esc="p.siswa_id.nis"/></td>
                                            <td><t t-esc="p.siswa_id.name"/></td>
                                            <td class="center"><t t-esc="p.kelas_id.name"/></td>
                                            <td class="center" style="color: #16a34a;"><t t-esc="p.jumlah_benar"/></td>
                                            <td class="center" style="color: #dc2626;"><t t-esc="p.jumlah_salah"/></td>
                                            <td class="center" t-attf-class="#{p.is_lulus and 'nilai-lulus' or 'nilai-tidak-lulus'}">
                                                <t t-esc="'%.1f' % p.nilai"/>
                                            </td>
                                            <td class="center">
                                                <t t-if="p.is_lulus"><span class="badge-lulus">LULUS</span></t>
                                                <t t-else=""><span class="badge-tidak-lulus">TL</span></t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="legend-section">
                            <span class="legend-text">Keterangan: </span>
                            <span class="badge-lulus" style="margin-left: 10px;">LULUS</span>
                            <span class="legend-text"> = Lulus (Nilai &gt;= KKM) | </span>
                            <span class="badge-tidak-lulus">TL</span>
                            <span class="legend-text"> = Tidak Lulus (Nilai &lt; KKM)</span>
                        </div>

                        <div class="footer-section">
                            <table class="footer-table">
                                <tr>
                                    <td class="footer-notes">
                                        <div class="notes-title">Catatan</div>
                                        <div class="notes-list">
                                            1. Dokumen ini adalah rekap hasil ujian resmi<br/>
                                            2. Nilai telah dihitung secara otomatis oleh sistem<br/>
                                            3. Daftar diurutkan berdasarkan nilai tertinggi
                                        </div>
                                    </td>
                                    <td class="footer-signature">
                                        <div class="signature-date">
                                            <t t-esc="company.city or ''"/>, <span t-esc="datetime.datetime.now().strftime('%d %B %Y')"/>
                                        </div>
                                        <div class="signature-title">Guru Pengampu,</div>
                                        <div class="signature-line"></div>
                                        <div class="signature-name"><span t-field="doc.guru_id.name"/></div>
                                        <div class="signature-role">NIP. -</div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="footer-bottom">
                            <p class="footer-text">
                                Dokumen ini dicetak secara otomatis oleh sistem<br/>
                                <strong style="color: #2563eb;"><t t-esc="company.name"/></strong> - Sistem Ujian Online
                            </p>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
