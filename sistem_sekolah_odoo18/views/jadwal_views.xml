<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_jadwal_tree" model="ir.ui.view">
            <field name="name">sekolah.jadwal.tree</field>
            <field name="model">sekolah.jadwal</field>
            <field name="arch" type="xml">
                <list string="Jadwal Pelajaran">
                    <field name="hari"/>
                    <field name="jam_ke"/>
                    <field name="jam_mulai" widget="float_time"/>
                    <field name="jam_selesai" widget="float_time"/>
                    <field name="kelas_id"/>
                    <field name="mata_pelajaran_id"/>
                    <field name="guru_id"/>
                    <field name="ruangan"/>
                </list>
            </field>
        </record>

        <record id="view_jadwal_form" model="ir.ui.view">
            <field name="name">sekolah.jadwal.form</field>
            <field name="model">sekolah.jadwal</field>
            <field name="arch" type="xml">
                <form string="Jadwal Pelajaran">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="kelas_id"/>
                                <field name="mata_pelajaran_id"/>
                                <field name="guru_id"/>
                            </group>
                            <group>
                                <field name="hari"/>
                                <field name="jam_ke"/>
                                <field name="jam_mulai" widget="float_time"/>
                                <field name="jam_selesai" widget="float_time"/>
                                <field name="durasi" widget="float_time"/>
                                <field name="ruangan"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="tahun_ajaran_id"/>
                                <field name="semester"/>
                            </group>
                        </group>
                        <group>
                            <field name="keterangan" nolabel="1" placeholder="Keterangan..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_jadwal_calendar" model="ir.ui.view">
            <field name="name">sekolah.jadwal.calendar</field>
            <field name="model">sekolah.jadwal</field>
            <field name="arch" type="xml">
                <calendar string="Jadwal" date_start="jam_mulai" color="kelas_id" mode="week">
                    <field name="name"/>
                    <field name="kelas_id"/>
                    <field name="guru_id"/>
                </calendar>
            </field>
        </record>

        <record id="action_jadwal" model="ir.actions.act_window">
            <field name="name">Jadwal Pelajaran</field>
            <field name="res_model">sekolah.jadwal</field>
            <field name="view_mode">calendar,list,form</field>
        </record>

        <menuitem id="menu_jadwal"
                  name="Jadwal Pelajaran"
                  parent="menu_sekolah_akademik"
                  action="action_jadwal"
                  sequence="10"/>

    </data>
</odoo>
