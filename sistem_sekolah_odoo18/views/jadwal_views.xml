<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_jadwal_tree" model="ir.ui.view">
            <field name="name">sekolah.jadwal.tree</field>
            <field name="model">sekolah.jadwal</field>
            <field name="arch" type="xml">
                <list string="Jadwal Pelajaran">
                    <field name="hari"/>
                    <field name="jam_ke"/>
                    <field name="jam_mulai" widget="float_time"/>
                    <field name="jam_selesai" widget="float_time"/>
                    <field name="kelas_id"/>
                    <field name="mata_pelajaran_id"/>
                    <field name="guru_id"/>
                    <field name="ruangan"/>
                </list>
            </field>
        </record>

        <record id="view_jadwal_form" model="ir.ui.view">
            <field name="name">sekolah.jadwal.form</field>
            <field name="model">sekolah.jadwal</field>
            <field name="arch" type="xml">
                <form string="Jadwal Pelajaran">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="kelas_id"/>
                                <field name="mata_pelajaran_id"/>
                                <field name="guru_id"/>
                            </group>
                            <group>
                                <field name="hari"/>
                                <field name="jam_ke"/>
                                <field name="jam_mulai" widget="float_time"/>
                                <field name="jam_selesai" widget="float_time"/>
                                <field name="durasi" widget="float_time"/>
                                <field name="ruangan"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="tahun_ajaran_id"/>
                                <field name="semester"/>
                            </group>
                        </group>
                        <group>
                            <field name="keterangan" nolabel="1" placeholder="Keterangan..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_jadwal_search" model="ir.ui.view">
            <field name="name">sekolah.jadwal.search</field>
            <field name="model">sekolah.jadwal</field>
            <field name="arch" type="xml">
                <search string="Cari Jadwal">
                    <field name="name"/>
                    <field name="kelas_id"/>
                    <field name="mata_pelajaran_id"/>
                    <field name="guru_id"/>
                    <filter string="Senin" name="filter_senin" domain="[('hari', '=', 'senin')]"/>
                    <filter string="Selasa" name="filter_selasa" domain="[('hari', '=', 'selasa')]"/>
                    <filter string="Rabu" name="filter_rabu" domain="[('hari', '=', 'rabu')]"/>
                    <filter string="Kamis" name="filter_kamis" domain="[('hari', '=', 'kamis')]"/>
                    <filter string="Jumat" name="filter_jumat" domain="[('hari', '=', 'jumat')]"/>
                    <filter string="Sabtu" name="filter_sabtu" domain="[('hari', '=', 'sabtu')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Hari" name="group_hari" context="{'group_by': 'hari'}"/>
                        <filter string="Kelas" name="group_kelas" context="{'group_by': 'kelas_id'}"/>
                        <filter string="Guru" name="group_guru" context="{'group_by': 'guru_id'}"/>
                        <filter string="Mata Pelajaran" name="group_mapel" context="{'group_by': 'mata_pelajaran_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_jadwal" model="ir.actions.act_window">
            <field name="name">Jadwal Pelajaran</field>
            <field name="res_model">sekolah.jadwal</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_jadwal"
                  name="Jadwal Pelajaran"
                  parent="menu_sekolah_akademik"
                  action="action_jadwal"
                  sequence="10"/>

    </data>
</odoo>
