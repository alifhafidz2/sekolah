<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="portal_no_data" name="Portal No Data">
            <t t-call="portal.portal_layout">
                <div class="container mt-5">
                    <div class="alert alert-warning" role="alert">
                        <h4 class="alert-heading">Data Tidak Ditemukan</h4>
                        <p><t t-out="message"/></p>
                    </div>
                </div>
            </t>
        </template>

        <template id="portal_siswa_profile" name="Portal Siswa Profile">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="row">
                        <div class="col-md-3">
                            <img t-if="siswa.foto" t-att-src="image_data_uri(siswa.foto)" class="img-fluid rounded" alt="Foto Siswa"/>
                            <div t-else="" class="bg-secondary text-white text-center p-5 rounded">
                                <i class="fa fa-user fa-5x"/>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <h2><t t-out="siswa.name"/></h2>
                            <p class="lead">NIS: <t t-out="siswa.nis"/></p>

                            <div class="card mt-3">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">Data Pribadi</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p><strong>Jenis Kelamin:</strong> <t t-out="dict(siswa._fields['jenis_kelamin'].selection).get(siswa.jenis_kelamin)"/></p>
                                            <p><strong>Tempat, Tanggal Lahir:</strong> <t t-out="siswa.tempat_lahir"/>, <t t-out="siswa.tanggal_lahir"/></p>
                                            <p><strong>Umur:</strong> <t t-out="siswa.umur"/> tahun</p>
                                        </div>
                                        <div class="col-md-6">
                                            <p><strong>Kelas:</strong> <t t-out="siswa.kelas_id.name if siswa.kelas_id else '-'"/></p>
                                            <p><strong>Status:</strong> <span t-att-class="'badge ' + ('badge-success' if siswa.status == 'aktif' else 'badge-info')"><t t-out="dict(siswa._fields['status'].selection).get(siswa.status)"/></span></p>
                                            <p><strong>Tanggal Masuk:</strong> <t t-out="siswa.tanggal_masuk"/></p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card mt-3">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0">Statistik</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6>Kehadiran</h6>
                                            <p>Total Absensi: <strong><t t-out="siswa.total_absensi"/></strong></p>
                                            <p>Hadir: <strong><t t-out="siswa.total_hadir"/></strong></p>
                                            <p>Izin: <strong><t t-out="siswa.total_izin"/></strong></p>
                                            <p>Sakit: <strong><t t-out="siswa.total_sakit"/></strong></p>
                                            <p>Alfa: <strong><t t-out="siswa.total_alfa"/></strong></p>
                                            <p>Persentase Kehadiran: <strong><t t-out="'%.2f' % siswa.persentase_kehadiran"/>%</strong></p>
                                        </div>
                                        <div class="col-md-6">
                                            <h6>Akademik</h6>
                                            <p>Rata-rata Nilai: <strong><t t-out="'%.2f' % siswa.rata_rata_nilai"/></strong></p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <a href="/my/siswa/nilai" class="btn btn-primary mr-2">Lihat Nilai</a>
                                <a href="/my/siswa/absensi" class="btn btn-info mr-2">Lihat Absensi</a>
                                <a href="/my/siswa/jadwal" class="btn btn-success">Lihat Jadwal</a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="portal_siswa_nilai" name="Portal Siswa Nilai">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <h2>Nilai - <t t-out="siswa.name"/></h2>
                    <a href="/my/siswa" class="btn btn-secondary mb-3">Kembali ke Profil</a>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Mata Pelajaran</th>
                                    <th>Tahun Ajaran</th>
                                    <th>Semester</th>
                                    <th>Tugas</th>
                                    <th>UTS</th>
                                    <th>UAS</th>
                                    <th>Praktik</th>
                                    <th>Nilai Akhir</th>
                                    <th>Predikat</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="nilai_list" t-as="nilai">
                                    <tr>
                                        <td><t t-out="nilai.mata_pelajaran_id.name"/></td>
                                        <td><t t-out="nilai.tahun_ajaran_id.name if nilai.tahun_ajaran_id else '-'"/></td>
                                        <td><t t-out="dict(nilai._fields['semester'].selection).get(nilai.semester) if nilai.semester else '-'"/></td>
                                        <td><t t-out="'%.2f' % nilai.nilai_tugas"/></td>
                                        <td><t t-out="'%.2f' % nilai.nilai_uts"/></td>
                                        <td><t t-out="'%.2f' % nilai.nilai_uas"/></td>
                                        <td><t t-out="'%.2f' % nilai.nilai_praktik"/></td>
                                        <td><strong><t t-out="'%.2f' % nilai.nilai_akhir"/></strong></td>
                                        <td><t t-out="dict(nilai._fields['predikat'].selection).get(nilai.predikat)"/></td>
                                        <td>
                                            <span t-att-class="'badge ' + ('badge-success' if nilai.status_kelulusan == 'lulus' else ('badge-warning' if nilai.status_kelulusan == 'remedial' else 'badge-danger'))">
                                                <t t-out="dict(nilai._fields['status_kelulusan'].selection).get(nilai.status_kelulusan)"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <template id="portal_siswa_absensi" name="Portal Siswa Absensi">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <h2>Absensi - <t t-out="siswa.name"/></h2>
                    <a href="/my/siswa" class="btn btn-secondary mb-3">Kembali ke Profil</a>

                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card text-center bg-success text-white">
                                <div class="card-body">
                                    <h3><t t-out="siswa.total_hadir"/></h3>
                                    <p>Hadir</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-info text-white">
                                <div class="card-body">
                                    <h3><t t-out="siswa.total_izin"/></h3>
                                    <p>Izin</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-warning text-white">
                                <div class="card-body">
                                    <h3><t t-out="siswa.total_sakit"/></h3>
                                    <p>Sakit</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-danger text-white">
                                <div class="card-body">
                                    <h3><t t-out="siswa.total_alfa"/></h3>
                                    <p>Alfa</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Tanggal</th>
                                    <th>Mata Pelajaran</th>
                                    <th>Guru</th>
                                    <th>Status</th>
                                    <th>Keterangan</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="absensi_list" t-as="absensi">
                                    <tr>
                                        <td><t t-out="absensi.tanggal"/></td>
                                        <td><t t-out="absensi.mata_pelajaran_id.name if absensi.mata_pelajaran_id else '-'"/></td>
                                        <td><t t-out="absensi.guru_id.name if absensi.guru_id else '-'"/></td>
                                        <td>
                                            <span t-att-class="'badge ' + ('badge-success' if absensi.status == 'hadir' else ('badge-warning' if absensi.status in ['izin', 'sakit'] else 'badge-danger'))">
                                                <t t-out="dict(absensi._fields['status'].selection).get(absensi.status)"/>
                                            </span>
                                        </td>
                                        <td><t t-out="absensi.keterangan or '-'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <template id="portal_siswa_jadwal" name="Portal Siswa Jadwal">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <h2>Jadwal Pelajaran - <t t-out="siswa.kelas_id.name"/></h2>
                    <a href="/my/siswa" class="btn btn-secondary mb-3">Kembali ke Profil</a>

                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Hari</th>
                                    <th>Jadwal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="hari_list" t-as="hari">
                                    <tr>
                                        <td class="font-weight-bold text-capitalize"><t t-out="hari"/></td>
                                        <td>
                                            <t t-if="jadwal_by_hari[hari]">
                                                <t t-foreach="jadwal_by_hari[hari]" t-as="jadwal">
                                                    <div class="mb-2">
                                                        <strong>Jam ke-<t t-out="jadwal.jam_ke"/> (<t t-out="jadwal.get_display_time()"/>)</strong><br/>
                                                        <t t-out="jadwal.mata_pelajaran_id.name"/> - <t t-out="jadwal.guru_id.name"/><br/>
                                                        <small class="text-muted">Ruangan: <t t-out="jadwal.ruangan or '-'"/></small>
                                                    </div>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <em class="text-muted">Tidak ada jadwal</em>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <template id="portal_guru_profile" name="Portal Guru Profile">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <div class="row">
                        <div class="col-md-3">
                            <img t-if="guru.foto" t-att-src="image_data_uri(guru.foto)" class="img-fluid rounded" alt="Foto Guru"/>
                            <div t-else="" class="bg-secondary text-white text-center p-5 rounded">
                                <i class="fa fa-user fa-5x"/>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <h2><t t-out="guru.name"/></h2>
                            <p class="lead">NIP: <t t-out="guru.nip"/></p>

                            <div class="card mt-3">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">Data Kepegawaian</h5>
                                </div>
                                <div class="card-body">
                                    <p><strong>Spesialisasi:</strong> <t t-out="guru.spesialisasi or '-'"/></p>
                                    <p><strong>Pendidikan Terakhir:</strong> <t t-out="dict(guru._fields['pendidikan_terakhir'].selection).get(guru.pendidikan_terakhir) if guru.pendidikan_terakhir else '-'"/></p>
                                    <p><strong>Status Kepegawaian:</strong> <t t-out="dict(guru._fields['status_kepegawaian'].selection).get(guru.status_kepegawaian)"/></p>
                                    <p><strong>Status:</strong> <span t-att-class="'badge ' + ('badge-success' if guru.status == 'aktif' else 'badge-secondary')"><t t-out="dict(guru._fields['status'].selection).get(guru.status)"/></span></p>
                                </div>
                            </div>

                            <div class="mt-3">
                                <a href="/my/guru/jadwal" class="btn btn-primary">Lihat Jadwal Mengajar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="portal_guru_jadwal" name="Portal Guru Jadwal">
            <t t-call="portal.portal_layout">
                <div class="container mt-4">
                    <h2>Jadwal Mengajar - <t t-out="guru.name"/></h2>
                    <a href="/my/guru" class="btn btn-secondary mb-3">Kembali ke Profil</a>

                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Hari</th>
                                    <th>Jadwal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="hari_list" t-as="hari">
                                    <tr>
                                        <td class="font-weight-bold text-capitalize"><t t-out="hari"/></td>
                                        <td>
                                            <t t-if="jadwal_by_hari[hari]">
                                                <t t-foreach="jadwal_by_hari[hari]" t-as="jadwal">
                                                    <div class="mb-2">
                                                        <strong>Jam ke-<t t-out="jadwal.jam_ke"/> (<t t-out="jadwal.get_display_time()"/>)</strong><br/>
                                                        <t t-out="jadwal.mata_pelajaran_id.name"/> - <t t-out="jadwal.kelas_id.name"/><br/>
                                                        <small class="text-muted">Ruangan: <t t-out="jadwal.ruangan or '-'"/></small>
                                                    </div>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <em class="text-muted">Tidak ada jadwal</em>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
