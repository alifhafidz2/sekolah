<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_absensi_tree" model="ir.ui.view">
            <field name="name">sekolah.absensi.tree</field>
            <field name="model">sekolah.absensi</field>
            <field name="arch" type="xml">
                <list string="Absensi Siswa">
                    <field name="name"/>
                    <field name="tanggal"/>
                    <field name="siswa_id"/>
                    <field name="kelas_id"/>
                    <field name="mata_pelajaran_id"/>
                    <field name="status" decoration-success="status == 'hadir'" decoration-warning="status in ['izin', 'sakit']" decoration-danger="status == 'alfa'"/>
                </list>
            </field>
        </record>

        <record id="view_absensi_form" model="ir.ui.view">
            <field name="name">sekolah.absensi.form</field>
            <field name="model">sekolah.absensi</field>
            <field name="arch" type="xml">
                <form string="Absensi Siswa">
                    <header>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="tanggal"/>
                                <field name="siswa_id"/>
                                <field name="kelas_id"/>
                            </group>
                            <group>
                                <field name="jadwal_id"/>
                                <field name="mata_pelajaran_id"/>
                                <field name="guru_id"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="tahun_ajaran_id"/>
                                <field name="semester"/>
                            </group>
                        </group>
                        <group>
                            <field name="keterangan" nolabel="1" placeholder="Keterangan..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_absensi" model="ir.actions.act_window">
            <field name="name">Absensi Siswa</field>
            <field name="res_model">sekolah.absensi</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_absensi_massal_wizard" model="ir.actions.act_window">
            <field name="name">Input Absensi Massal</field>
            <field name="res_model">sekolah.absensi.massal.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_absensi"
                  name="Absensi"
                  parent="menu_sekolah_akademik"
                  action="action_absensi"
                  sequence="20"/>

        <menuitem id="menu_absensi_massal"
                  name="Input Absensi Massal"
                  parent="menu_sekolah_akademik"
                  action="action_absensi_massal_wizard"
                  sequence="21"/>

    </data>
</odoo>
