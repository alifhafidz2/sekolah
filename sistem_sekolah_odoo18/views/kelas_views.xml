<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_kelas_tree" model="ir.ui.view">
            <field name="name">sekolah.kelas.tree</field>
            <field name="model">sekolah.kelas</field>
            <field name="arch" type="xml">
                <list string="Data Kelas">
                    <field name="name"/>
                    <field name="tingkat"/>
                    <field name="jurusan"/>
                    <field name="wali_kelas_id"/>
                    <field name="jumlah_siswa"/>
                    <field name="kapasitas"/>
                    <field name="persentase_terisi" widget="percentage"/>
                </list>
            </field>
        </record>

        <record id="view_kelas_form" model="ir.ui.view">
            <field name="name">sekolah.kelas.form</field>
            <field name="model">sekolah.kelas</field>
            <field name="arch" type="xml">
                <form string="Data Kelas">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_siswa" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="jumlah_siswa" widget="statinfo" string="Siswa"/>
                            </button>
                            <button name="action_view_jadwal" type="object" class="oe_stat_button" icon="fa-calendar">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Jadwal</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nama Kelas"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="tingkat"/>
                                <field name="jurusan"/>
                                <field name="wali_kelas_id"/>
                                <field name="tahun_ajaran_id"/>
                            </group>
                            <group>
                                <field name="kapasitas"/>
                                <field name="ruang_kelas"/>
                                <field name="is_full"/>
                                <field name="persentase_terisi" widget="percentage"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Daftar Siswa">
                                <field name="siswa_ids" nolabel="1">
                                    <list>
                                        <field name="nis"/>
                                        <field name="name"/>
                                        <field name="jenis_kelamin"/>
                                        <field name="status"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Keterangan">
                                <field name="keterangan" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_kelas_kanban" model="ir.ui.view">
            <field name="name">sekolah.kelas.kanban</field>
            <field name="model">sekolah.kelas</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="tingkat"/>
                    <field name="wali_kelas_id"/>
                    <field name="jumlah_siswa"/>
                    <field name="kapasitas"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="o_kanban_record_subtitle">
                                        Tingkat: <field name="tingkat"/>
                                    </div>
                                    <div>
                                        Wali Kelas: <field name="wali_kelas_id"/>
                                    </div>
                                    <div>
                                        Siswa: <field name="jumlah_siswa"/> / <field name="kapasitas"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_kelas" model="ir.actions.act_window">
            <field name="name">Data Kelas</field>
            <field name="res_model">sekolah.kelas</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <menuitem id="menu_kelas"
                  name="Kelas"
                  parent="menu_sekolah_master"
                  action="action_kelas"
                  sequence="10"/>

    </data>
</odoo>
