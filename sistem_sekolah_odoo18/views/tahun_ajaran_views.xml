<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tahun_ajaran_tree" model="ir.ui.view">
        <field name="name">sekolah.tahun.ajaran.tree</field>
        <field name="model">sekolah.tahun_ajaran</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tahun_mulai"/>
                <field name="tahun_selesai"/>
                <field name="semester"/>
                <field name="tanggal_mulai"/>
                <field name="tanggal_selesai"/>
                <field name="is_active"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_tahun_ajaran_form" model="ir.ui.view">
        <field name="name">sekolah.tahun.ajaran.form</field>
        <field name="model">sekolah.tahun_ajaran</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_active" string="Aktifkan" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_set_done" string="Selesai" type="object"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tahun_mulai"/>
                            <field name="tahun_selesai"/>
                            <field name="semester"/>
                        </group>
                        <group>
                            <field name="tanggal_mulai"/>
                            <field name="tanggal_selesai"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group>
                        <field name="keterangan"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tahun_ajaran" model="ir.actions.act_window">
        <field name="name">Tahun Ajaran</field>
        <field name="res_model">sekolah.tahun_ajaran</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tahun_ajaran"
              name="Tahun Ajaran"
              parent="menu_sekolah_master"
              action="action_tahun_ajaran"
              sequence="15"/>
</odoo>
