<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_generate_jadwal_wizard_form" model="ir.ui.view">
            <field name="name">sekolah.generate.jadwal.wizard.form</field>
            <field name="model">sekolah.generate.jadwal.wizard</field>
            <field name="arch" type="xml">
                <form string="Generate Jadwal">
                    <group>
                        <group string="Pengaturan Umum">
                            <field name="kelas_id"/>
                            <field name="tahun_ajaran_id"/>
                            <field name="hapus_jadwal_lama"/>
                        </group>
                        <group string="Waktu">
                            <field name="jam_mulai_default" widget="float_time"/>
                            <field name="jam_selesai_default" widget="float_time"/>
                            <field name="durasi_per_sesi" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Pilih Hari">
                        <group>
                            <field name="hari_senin"/>
                            <field name="hari_selasa"/>
                            <field name="hari_rabu"/>
                        </group>
                        <group>
                            <field name="hari_kamis"/>
                            <field name="hari_jumat"/>
                            <field name="hari_sabtu"/>
                        </group>
                    </group>
                    <group>
                        <group string="Istirahat 1">
                            <field name="istirahat_1"/>
                            <field name="jam_istirahat_1" widget="float_time" invisible="not istirahat_1"/>
                            <field name="durasi_istirahat_1" widget="float_time" invisible="not istirahat_1"/>
                        </group>
                        <group string="Istirahat 2 (Siang)">
                            <field name="istirahat_2"/>
                            <field name="jam_istirahat_2" widget="float_time" invisible="not istirahat_2"/>
                            <field name="durasi_istirahat_2" widget="float_time" invisible="not istirahat_2"/>
                        </group>
                    </group>
                    <separator string="Mata Pelajaran"/>
                    <group>
                        <field name="mata_pelajaran_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <footer>
                        <button name="action_generate" type="object" string="Generate Jadwal" class="btn-primary"/>
                        <button string="Batal" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_generate_jadwal_wizard" model="ir.actions.act_window">
            <field name="name">Generate Jadwal</field>
            <field name="res_model">sekolah.generate.jadwal.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_generate_jadwal"
                  name="Generate Jadwal"
                  parent="menu_sekolah_akademik"
                  action="action_generate_jadwal_wizard"
                  sequence="11"/>

    </data>
</odoo>
