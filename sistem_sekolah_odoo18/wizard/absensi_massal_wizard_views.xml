<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_absensi_massal_wizard_form" model="ir.ui.view">
            <field name="name">sekolah.absensi.massal.wizard.form</field>
            <field name="model">sekolah.absensi.massal.wizard</field>
            <field name="arch" type="xml">
                <form string="Input Absensi Massal">
                    <group>
                        <group>
                            <field name="kelas_id"/>
                            <field name="jadwal_id"/>
                        </group>
                        <group>
                            <field name="tanggal"/>
                            <field name="tahun_ajaran_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daftar Siswa">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="siswa_id" readonly="1"/>
                                    <field name="status"/>
                                    <field name="keterangan"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_create_absensi" type="object" string="Buat Absensi" class="btn-primary"/>
                        <button string="Batal" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
