<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_log_form" model="ir.ui.view">
        <field name="name">whatsapp.log.form</field>
        <field name="model">whatsapp.log</field>
        <field name="arch" type="xml">
            <form string="Log WhatsApp" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="siswa_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi">
                            <field name="absensi_id"/>
                            <field name="phone_number"/>
                            <field name="recipient_type"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'sent'"
                                   decoration-danger="status == 'failed'"
                                   decoration-warning="status == 'pending'"/>
                            <field name="sent_date"/>
                        </group>
                    </group>
                    <group string="Pesan">
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Response API" invisible="not response">
                        <field name="response" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_log_tree" model="ir.ui.view">
        <field name="name">whatsapp.log.tree</field>
        <field name="model">whatsapp.log</field>
        <field name="arch" type="xml">
            <list string="Log WhatsApp" create="false" edit="false" decoration-success="status == 'sent'" decoration-danger="status == 'failed'" decoration-warning="status == 'pending'">
                <field name="create_date" string="Tanggal"/>
                <field name="siswa_id"/>
                <field name="phone_number"/>
                <field name="recipient_type"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'sent'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'pending'"/>
                <field name="sent_date"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_log_search" model="ir.ui.view">
        <field name="name">whatsapp.log.search</field>
        <field name="model">whatsapp.log</field>
        <field name="arch" type="xml">
            <search string="Cari Log">
                <field name="siswa_id"/>
                <field name="phone_number"/>
                <filter name="filter_sent" string="Terkirim" domain="[('status', '=', 'sent')]"/>
                <filter name="filter_failed" string="Gagal" domain="[('status', '=', 'failed')]"/>
                <filter name="filter_pending" string="Menunggu" domain="[('status', '=', 'pending')]"/>
                <separator/>
                <filter name="filter_today" string="Hari Ini" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_siswa" string="Siswa" context="{'group_by': 'siswa_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_recipient" string="Penerima" context="{'group_by': 'recipient_type'}"/>
                    <filter name="group_date" string="Tanggal" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_log" model="ir.actions.act_window">
        <field name="name">Log WhatsApp</field>
        <field name="res_model">whatsapp.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada log pengiriman WhatsApp
            </p>
            <p>
                Log akan muncul di sini ketika ada siswa yang tercatat alfa
                dan notifikasi WhatsApp dikirim ke orang tua/wali.
            </p>
        </field>
    </record>

    <record id="view_absensi_form_whatsapp" model="ir.ui.view">
        <field name="name">sekolah.absensi.form.whatsapp</field>
        <field name="model">sekolah.absensi</field>
        <field name="inherit_id" ref="sistem_sekolah_odoo18.view_absensi_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="WhatsApp Notifikasi" invisible="status != 'alfa'">
                    <group>
                        <field name="whatsapp_sent" readonly="1"/>
                    </group>
                    <group>
                        <button name="action_resend_whatsapp"
                                type="object"
                                string="Kirim Ulang WhatsApp"
                                class="btn-primary"
                                icon="fa-whatsapp"
                                invisible="status != 'alfa'"/>
                        <button name="action_view_whatsapp_logs"
                                type="object"
                                string="Lihat Log"
                                class="btn-secondary"
                                icon="fa-history"
                                invisible="not whatsapp_log_ids"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
