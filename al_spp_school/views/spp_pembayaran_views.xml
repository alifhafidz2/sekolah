<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spp_pembayaran_list" model="ir.ui.view">
        <field name="name">al.spp.pembayaran.list</field>
        <field name="model">al.spp.pembayaran</field>
        <field name="arch" type="xml">
            <list string="Pembayaran SPP" decoration-success="state == 'confirmed'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="tanggal_bayar"/>
                <field name="siswa_id"/>
                <field name="kelas_id"/>
                <field name="jenis_tagihan"/>
                <field name="bulan_tagihan"/>
                <field name="tahun_tagihan"/>
                <field name="nominal" widget="monetary" sum="Total"/>
                <field name="metode_bayar"/>
                <field name="penerima_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_spp_pembayaran_form" model="ir.ui.view">
        <field name="name">al.spp.pembayaran.form</field>
        <field name="model">al.spp.pembayaran</field>
        <field name="arch" type="xml">
            <form string="Pembayaran SPP">
                <header>
                    <button name="action_confirm" string="Konfirmasi" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print_kwitansi" string="Cetak Kwitansi" type="object"
                            class="btn-secondary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Batalkan" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_set_to_draft" string="Set ke Draft" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Tagihan">
                            <field name="tagihan_id"/>
                            <field name="siswa_id"/>
                            <field name="kelas_id"/>
                            <field name="jenis_tagihan"/>
                            <field name="bulan_tagihan"/>
                            <field name="tahun_tagihan"/>
                        </group>
                        <group string="Pembayaran">
                            <field name="tanggal_bayar"/>
                            <field name="nominal" widget="monetary"/>
                            <field name="metode_bayar"/>
                            <field name="bank_id" invisible="metode_bayar not in ['transfer', 'va']"/>
                            <field name="no_referensi" invisible="metode_bayar == 'tunai'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Bukti Pembayaran">
                            <field name="bukti_bayar" widget="image" class="oe_avatar"/>
                            <field name="bukti_bayar_filename" invisible="1"/>
                        </group>
                        <group string="Penerima">
                            <field name="penerima_id"/>
                        </group>
                    </group>
                    <group string="Catatan">
                        <field name="notes" nolabel="1" placeholder="Catatan tambahan..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_spp_pembayaran_search" model="ir.ui.view">
        <field name="name">al.spp.pembayaran.search</field>
        <field name="model">al.spp.pembayaran</field>
        <field name="arch" type="xml">
            <search string="Cari Pembayaran">
                <field name="name"/>
                <field name="siswa_id"/>
                <field name="kelas_id"/>
                <field name="tagihan_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Dikonfirmasi" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Dibatalkan" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Hari Ini" name="today" domain="[('tanggal_bayar', '=', context_today())]"/>
                <filter string="Minggu Ini" name="this_week"
                        domain="[('tanggal_bayar', '>=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="Bulan Ini" name="this_month"
                        domain="[('tanggal_bayar', '>=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Tunai" name="tunai" domain="[('metode_bayar', '=', 'tunai')]"/>
                <filter string="Transfer" name="transfer" domain="[('metode_bayar', '=', 'transfer')]"/>
                <group expand="0" string="Group By">
                    <filter string="Siswa" name="group_siswa" context="{'group_by': 'siswa_id'}"/>
                    <filter string="Kelas" name="group_kelas" context="{'group_by': 'kelas_id'}"/>
                    <filter string="Tanggal" name="group_tanggal" context="{'group_by': 'tanggal_bayar:month'}"/>
                    <filter string="Metode" name="group_metode" context="{'group_by': 'metode_bayar'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_spp_pembayaran" model="ir.actions.act_window">
        <field name="name">Pembayaran SPP</field>
        <field name="res_model">al.spp.pembayaran</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada pembayaran
            </p>
            <p>
                Pembayaran dapat dilakukan dari menu Tagihan SPP.
            </p>
        </field>
    </record>

    <record id="action_spp_pembayaran_hari_ini" model="ir.actions.act_window">
        <field name="name">Pembayaran Hari Ini</field>
        <field name="res_model">al.spp.pembayaran</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1, 'search_default_confirmed': 1}</field>
    </record>
</odoo>
