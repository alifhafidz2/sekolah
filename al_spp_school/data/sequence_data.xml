<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_spp_tagihan" model="ir.sequence">
        <field name="name">Tagihan SPP</field>
        <field name="code">al.spp.tagihan</field>
        <field name="prefix">TAG/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_spp_pembayaran" model="ir.sequence">
        <field name="name">Pembayaran SPP</field>
        <field name="code">al.spp.pembayaran</field>
        <field name="prefix">PAY/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
